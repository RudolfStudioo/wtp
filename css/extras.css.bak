/* ===== Mode gelap (menimpa kelas Tailwind yang dipakai di index.html) ===== */
html.dark { color-scheme: dark; }
.dark body { background-color: #0b1220; color: #e2e8f0; }
.dark .bg-slate-100 { background-color: #0b1220; }
.dark .bg-white { background-color: #111c2f; }
.dark .bg-slate-50 { background-color: #17243a; }
.dark .hover\:bg-slate-50:hover { background-color: #1a2a44; }
.dark .border-slate-200 { border-color: #24344d; }
.dark .ring-slate-200 { --tw-ring-color: #24344d; }
.dark .text-slate-800 { color: #f1f5f9; }
.dark .text-slate-700 { color: #e2e8f0; }
.dark .text-slate-600 { color: #cbd5e1; }
.dark .text-slate-500 { color: #94a3b8; }
.dark .hover\:text-slate-800:hover { color: #f1f5f9; }
.dark .text-sky-700 { color: #7dd3fc; }
.dark .text-sky-600 { color: #38bdf8; }
.dark .text-red-600 { color: #f87171; }
.dark .text-emerald-600 { color: #34d399; }
.dark .bg-emerald-50 { background-color: rgba(16, 185, 129, .15); }
.dark .text-emerald-800 { color: #6ee7b7; }
.dark .bg-red-50 { background-color: rgba(239, 68, 68, .15); }
.dark .text-red-800 { color: #fca5a5; }
.dark .bg-sky-50 { background-color: rgba(14, 165, 233, .15); }
.dark .text-sky-800 { color: #7dd3fc; }
.dark input, .dark select { background-color: #17243a; color: #f1f5f9; }
.dark .quick-nominal.active { background-color: #0284c7; color: #fff; border-color: #0284c7; }
.dark .tab-button.active { color: #7dd3fc; border-color: #38bdf8; }

/* ===== Header: nama akun + hamburger ===== */
.uw-user { display: none; text-align: right; line-height: 1.15; }
@media (min-width: 640px) { .uw-user { display: block; } }
.uw-user-name { display: block; font-size: .8rem; font-weight: 600; }
.uw-user-role { display: block; font-size: .7rem; color: #64748b; }
.dark .uw-user-role { color: #94a3b8; }

.uw-menu-wrap { position: relative; }
.uw-menu-btn { display: flex; align-items: center; justify-content: center; width: 2.25rem; height: 2.25rem; border-radius: 8px; border: 1px solid #e2e8f0; background: #fff; color: #334155; cursor: pointer; }
.uw-menu-btn:hover { background: #f1f5f9; }
.dark .uw-menu-btn { background: #111c2f; border-color: #24344d; color: #e2e8f0; }
.dark .uw-menu-btn:hover { background: #1a2a44; }

.uw-menu { position: absolute; right: 0; top: calc(100% + .5rem); min-width: 15rem; z-index: 60; background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; box-shadow: 0 12px 30px rgba(15, 23, 42, .14); padding: .4rem; }
.uw-menu[hidden] { display: none; }
.dark .uw-menu { background: #111c2f; border-color: #24344d; box-shadow: 0 12px 30px rgba(0, 0, 0, .5); }
.uw-menu-head { padding: .5rem .65rem .6rem; border-bottom: 1px solid #e2e8f0; margin-bottom: .3rem; }
.dark .uw-menu-head { border-color: #24344d; }
.uw-item { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: .75rem; padding: .55rem .65rem; border-radius: 8px; font-size: .875rem; font-weight: 500; color: #334155; background: transparent; border: 0; cursor: pointer; text-align: left; }
.uw-item:hover { background: #f1f5f9; }
.uw-item.danger { color: #dc2626; }
.dark .uw-item { color: #e2e8f0; }
.dark .uw-item:hover { background: #1a2a44; }
.dark .uw-item.danger { color: #f87171; }
.uw-chip { font-size: .7rem; font-weight: 700; padding: .1rem .5rem; border-radius: 8px; background: #e2e8f0; color: #334155; }
.dark .uw-chip { background: #24344d; color: #e2e8f0; }

/* ===== Popup ===== */
.uw-backdrop { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 1rem; background: rgba(15, 23, 42, .55); backdrop-filter: blur(3px); }
.uw-backdrop[hidden] { display: none; }
.uw-backdrop.uw-top { z-index: 110; }
.uw-dialog { width: 100%; max-width: 24rem; background: #fff; color: #1e293b; border-radius: 8px; padding: 1.5rem; box-shadow: 0 20px 50px rgba(15, 23, 42, .3); }
.dark .uw-dialog { background: #111c2f; color: #f1f5f9; }
.uw-dialog h3 { font-size: 1.1rem; font-weight: 700; }
.uw-note { margin-top: .4rem; font-size: .75rem; color: #64748b; }
.dark .uw-note { color: #94a3b8; }
.uw-field { margin-top: 1rem; }
.uw-label { display: block; font-size: .7rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: #64748b; margin-bottom: .35rem; }
.dark .uw-label { color: #94a3b8; }
.uw-input { width: 100%; border: 1px solid #cbd5e1; border-radius: 8px; padding: .65rem .85rem; font-size: 1rem; outline: none; background: #fff; color: #0f172a; }
.uw-input:focus { box-shadow: 0 0 0 2px #38bdf8; border-color: transparent; }
.dark .uw-input { background: #17243a; border-color: #24344d; color: #f1f5f9; }
.uw-accounts { display: grid; gap: .5rem; }
.uw-account { display: flex; align-items: center; gap: .7rem; padding: .65rem .85rem; border: 1px solid #e2e8f0; border-radius: 8px; cursor: pointer; }
.uw-account:has(input:checked) { border-color: #0284c7; background: #f0f9ff; }
.dark .uw-account { border-color: #24344d; }
.dark .uw-account:has(input:checked) { border-color: #38bdf8; background: rgba(14, 165, 233, .12); }
.uw-error { margin-top: .5rem; font-size: .8rem; color: #dc2626; min-height: 1.1em; }
.dark .uw-error { color: #f87171; }
.uw-actions { margin-top: 1.25rem; display: flex; gap: .5rem; justify-content: flex-end; }
.uw-btn { border-radius: 8px; padding: .6rem 1rem; font-weight: 600; font-size: .9rem; cursor: pointer; border: 1px solid transparent; }
.uw-btn.primary { background: #0284c7; color: #fff; }
.uw-btn.primary:hover { background: #0369a1; }
.uw-btn.ghost { background: transparent; border-color: #cbd5e1; color: #334155; }
.dark .uw-btn.ghost { border-color: #24344d; color: #e2e8f0; }
.uw-center { text-align: center; }

.uw-toast { position: fixed; left: 50%; bottom: 1.5rem; z-index: 120; transform: translate(-50%, 12px); opacity: 0; pointer-events: none; background: #0f172a; color: #fff; padding: .6rem 1rem; border-radius: 8px; font-size: .85rem; transition: opacity .25s ease, transform .25s ease; }
.uw-toast.show { opacity: 1; transform: translate(-50%, 0); }
#sisa-liter { display: inline-block; transform-origin: left center; }

/* ===== Animasi kecil (mati otomatis kalau pengguna minta kurangi gerakan) ===== */
@media (prefers-reduced-motion: no-preference) {
  @keyframes uw-fade-up { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes uw-pop { from { opacity: 0; transform: translateY(-6px) scale(.97); } to { opacity: 1; transform: none; } }
  @keyframes uw-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes uw-bump { 0% { transform: scale(1); } 40% { transform: scale(1.07); } 100% { transform: scale(1); } }

  main .rounded-2xl { animation: uw-fade-up .45s ease both; }
  main .grid > :nth-child(2) { animation-delay: .06s; }
  main .grid > :nth-child(3) { animation-delay: .12s; }
  main .grid > :nth-child(4) { animation-delay: .18s; }
  main .grid > :nth-child(5) { animation-delay: .24s; }
  #payment-message:not(.hidden) { animation: uw-fade-up .3s ease both; }

  body, header, main .rounded-2xl, input, select { transition: background-color .25s ease, color .25s ease, border-color .25s ease; }
  button { transition: transform .15s ease, background-color .2s ease, color .2s ease, border-color .2s ease, box-shadow .2s ease; }
  .quick-nominal:hover { transform: translateY(-1px); }
  button:not(:disabled):active { transform: scale(.97); }

  .uw-menu:not([hidden]) { animation: uw-pop .16s ease both; transform-origin: top right; }
  .uw-backdrop:not([hidden]) { animation: uw-fade .18s ease both; }
  .uw-backdrop:not([hidden]) .uw-dialog { animation: uw-pop .22s ease both; }
  .uw-bump { animation: uw-bump .35s ease; }
}

/* ===== Semua sudut 8px (menimpa kelas Tailwind) ===== */
:root { --radius-xs: 8px; --radius-sm: 8px; --radius-md: 8px; --radius-lg: 8px; --radius-xl: 8px; --radius-2xl: 8px; --radius-3xl: 8px; }
.rounded, .rounded-md, .rounded-lg, .rounded-xl, .rounded-2xl, .rounded-3xl { border-radius: 8px !important; }
select:disabled { opacity: .75; cursor: not-allowed; }
